# Component service only: no prototype HTTP client or panel credentials.
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
COPY src/tend_mcp/__init__.py src/tend_mcp/component_worker.py /usr/local/lib/python3.12/site-packages/tend_mcp/
WORKDIR /app
USER 65532:65532
ENV PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8
CMD []
ENTRYPOINT ["/usr/local/bin/python", "-I", "-u", "-m", "tend_mcp.component_worker"]
